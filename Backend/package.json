{
  "name": "his",
  "version": "0.1.0",
  "description": "HIS Backend",
  "private": "true",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "start2": "nodemon scripts/dev.js --exec babel-node --extensions .js,.ts",
    "dev": "sh run.sh",
    "format": "prettier --write .",
    "lint": "tsc && eslint --ext .ts src --fix",
    "lint:fix": "tsc && eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "compile": "babel --copy-files src --extensions '.ts,.js' --out-dir build",
    "build": "yarn clean && yarn compile"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "axios": "^1.10.0",
    "bcrypt": "^5.1.1",
    "bluebird": "^3.7.2",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-fileupload": "^1.4.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "nodemon": "^3.0.1",
    "pm2": "^6.0.10",
    "pug": "^3.0.3",
    "rate-limiter-flexible": "^7.3.0",
    "redis": "4.7.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.1",
    "@babel/node": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.27.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bluebird": "^3.5.42",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.17",
    "@types/pug": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}