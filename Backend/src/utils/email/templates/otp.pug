extends layout.pug

block head
  title Secure Access Verification - Dhanvantari Healthcare
  style.
    .otp-container {
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      border: 2px dashed #2563eb;
      border-radius: 12px;
      padding: 30px;
      text-align: center;
      margin: 30px 0;
      position: relative;
      overflow: hidden;
    }
    .otp-container::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(37,99,235,0.05) 1px, transparent 1px);
      background-size: 20px 20px;
      animation: float 10s ease-in-out infinite;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(180deg); }
    }
    .otp-label {
      font-size: 14px;
      font-weight: 600;
      color: #6b7280;
      margin-bottom: 15px;
      text-transform: uppercase;
      letter-spacing: 1px;
      position: relative;
      z-index: 1;
    }
    .otp-code {
      font-size: 42px;
      font-weight: 800;
      color: #2563eb;
      letter-spacing: 8px;
      font-family: 'Courier New', monospace;
      margin: 15px 0;
      text-shadow: 0 2px 4px rgba(37,99,235,0.2);
      position: relative;
      z-index: 1;
    }
    .otp-validity {
      font-size: 14px;
      color: #ef4444;
      font-weight: 500;
      position: relative;
      z-index: 1;
    }

block content
  .content
    .greeting Hello #{name},
    .message
      | We've received a login request for your hospital's HIMS (Hospital Information Management System) account. To ensure the security of your healthcare data and maintain HIPAA compliance, please verify your identity using the One-Time Password (OTP) below.
    .otp-container
      .otp-label Your One-Time Password
      .otp-code #{otp}
      .otp-validity ⏰ Valid for 5 minutes only
    .message
      | Please enter this OTP in your login screen to complete the authentication process. This code is unique to your current session and will expire automatically for your security.
    .security-notice
      h3 Security Alert
      p
        strong Never share this OTP with anyone.
        | Dhanvantari Healthcare will never ask for your OTP via phone, email, or any other communication method. If you didn't request this login, please contact our support team immediately and change your password.
